# ==============================================================================
# Automated US Market Report Generator - Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' (never commit '.env' with personal secrets to git):
#   cp .env.example .env
#
# NOTE: ALL KEYS ARE 100% OPTIONAL!
# The engine works out of the box using free Yahoo Finance market data and local
# caches even if no environment variables are configured.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Macro & Economic Calendar Data Providers (Optional)
# ------------------------------------------------------------------------------
# St. Louis Fed FRED API: Used for US Treasury yield curves, credit spreads,
# real yields, and inflation expectations. Get a free API key at:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# Finnhub Calendar API: Used for forward earnings and economic event calendar.
# Get a free API key at: https://finnhub.io/
FINNHUB_API_KEY=""

# Financial Modeling Prep API (Optional fallback/stub):
FMP_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Automated Email Delivery via SMTP (Optional)
# ------------------------------------------------------------------------------
# To automatically receive generated reports with embedded charts via email:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
# Note: For Gmail, create an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD="your_16_char_app_password"
EMAIL_FROM="Market Reports <your_email@gmail.com>"
# Multiple recipient emails can be separated by commas:
EMAIL_TO="recipient1@example.com,recipient2@example.com"
